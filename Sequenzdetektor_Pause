library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.numeric_std.all;

entity BCD_Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic
	);
end BCD_Sequence_Detector;

architecture Behavioral of BCD_Sequence_Detector is
	
    -- Definition der Zustände der Zustandsmaschine
		type state_type is (S0,S1,S2,S3,S4,SEND);
		signal current_state, next_state : state_type;
		
		--Timer Signale
		signal timer_active : std_logic := '0';
		signal timer_counter : integer := 0;
		constant clock_frequency : integer := 100000000;
		constant pause_duration : integer := 200/10; 		--200ns

begin
  
  --Zustandsübergangsprocess (synchron mit dem Takt)
  process(clk, reset)
  begin
    if reset = '1' then
      current_state <= S0;
		next_state <= S0;
		timer_active <= '0';
		timer_counter <= 0;
		detected <= '0';
		
    elsif rising_edge(clk) then
    	current_state <= next_state;
		
			--Timer-Logik
			if timer_active = '1' then
				if timer_counter < pause_duration then
					timer_counter <= timer_counter +1;
				else
					timer_active <= '0';
					timer_counter <= 0;
				end if;
			end if;			

    case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when S4 =>
      	detected <= '1';							--Sequenz 3210 erkannt
			
		
			timer_active <= '1';
			
			
			next_state <= S0;
			
      when others =>
      	next_state <= S0;							--Fehlerbehandlung: Zurück zum Start
      
		end case;
	end if;
		
	end process;

end Behavioral;
