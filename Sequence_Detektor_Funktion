library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic;
	  serial_out : out std_logic
	);
end Sequence_Detector;

architecture Behavioral of Sequence_Detector is
	
    -- Definition der Zustände der Zustandsmaschine
		type state_type is (S0,S1,S2,S3,S4,SEND);
		signal current_state, next_state : state_type;
		
    timer_active : std_logic := 0;
    timer_counter : integer := 0;

		signal serial_seq : std_logic_vector(3 downto 0);
		signal serial_index : integer := 0;

    constant pause_duration : integer := 200;

--Funktion für die Zustandsmaschine
function state_transition(bcd_in : std_logic_vector(3 downto 0); current_state : state_type) return state_type is
begin

case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when others =>
      	return S0;
      
		end case;
end function;

--Function für die Sequencedetektion
function detect_sequence(current_state : state_type) return std_logic is
begin
  if current_state = S4 then
    return '1';    --Sequence erkannt
  else
    return '0';
  end if;
end function;

--Funktion für die Timersteuerung
procedure timer_process(signal_clk : std_logic; signal reset : in std_logic; signal timer_active : inout std_logic; signal timer_counter : inout integer) is
begin
  if reset = '1' then
		timer_active <= '0';
    timer_counter <= 0;
  elsif rising_edge(clk) then
    if timer_active = '1' then
      if timer_counter < pause_duration then
        timer_counter <= timer_counter +1;
      else
        timer_active <= '0';    --Timer beendet
        timer_counter <= 0;
      end if;
    end if;
  end if;
end procedure;
				








begin
  
  --Zustandsübergangsprocess (synchron mit dem Takt)
  process(clk, reset)
  begin
    if reset = '1' then
      current_state <= S0;
		--bit_counter <= (others => '0');
		bit_counter <= 0;
		shift_register <= (others => '0');
		--serial_out <= '0';
		sending <= '0';
    elsif rising_edge(clk) then
    	current_state <= next_state;
		
			if start_serial = '1' and sending = '0' then
				shift_register <= bcd_in;
				sending <= '1';
			end if;
			
			if sending = '1' then
				serial_out <= shift_register(0);
				shift_register <= '0' & shift_register(3 downto 1);
				
			if bit_counter = 3 then
				bit_counter <= 0;				
				sending <= '0';
			else
				bit_counter <= bit_counter + 1;
			end if;
			end if;
			
  	end if;
  end process;
  
  --Nächster Zusatnd und Ausgabelogik (kombinatorisch)
  process(current_state, bcd_in)
  begin
  
	--Standardwerte setzen  
  	next_state <= current_state;
   detected <= '0';
  
    case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when S4 =>
      	detected <= '1';							--Sequenz 3210 erkannt
			
      when others =>
      	next_state <= S0;							--Fehlerbehandlung: Zurück zum Start
      
		end case;
	end process;

end Behavioral;
