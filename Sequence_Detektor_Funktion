library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic;
	serial_out : out std_logic
	);
end Sequence_Detector;

architecture Behavioral of Sequence_Detector is
	
-- Definition der Zustände der Zustandsmaschine
	type state_type is (S0,S1,S2,S3,S4);
	signal current_state : state_type;
		
	signal timer_active : std_logic := '0';
	signal timer_counter : integer := 0;

	signal serial_seq : std_logic_vector(11 downto 0) := "000000000000";
	signal serial_index : integer := 0;
	signal sequence_detected : std_logic := '0';
	signal detected_flag : std_logic := '0';

   constant clock_frequency : integer := 10;							--10Hz
	constant pause_duration : integer := 10 * clock_frequency;	--10 sek

--Funktion für die Zustandsmaschine
function state_transition(bcd_in : std_logic_vector(3 downto 0); current_state : state_type) return state_type is
begin

case current_state is
      when S0 =>
      	if bcd_in = "0011" then
				return S1;
      	else
				return S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
				return S2;
      	else
				return S1;
			end if;
      
      when S2 =>
      	if bcd_in = "0001" then
				return S3;
      	else
				return S0;
			end if;
      
      when S3 =>
      	if bcd_in = "0000" then
				return S4;
      	else
				return S1;
			end if;
      
      when others =>
      	return S0;
      
		end case;
end function;

--Sequencedetektion
function detect_sequence(current_state : state_type) return std_logic is
begin
  if current_state = S4 then
    return '1';    --Sequence erkannt
  else
    return '0';
  end if;
end function;


begin

	-- FSM Process
	process(clk, reset)
	begin
		if reset = '1' then
			current_state <= S0;
		elsif rising_edge(clk) then
			current_state <= state_transition(bcd_in, current_state);
		end if;
	end process;
	
	--Hauptprocess: Sequenzdetektion, Timer Steuerung und serielle Ausgabe
	process(clk, reset)
	begin
		if reset = '1' then
			detected_flag <= '0';
			sequence_detected <= '0';
			timer_active <= '0';
			timer_counter <= 0;
			serial_index <= 0;
			serial_out <= '0';
			serial_seq <= "000000000000";
		elsif rising_edge(clk) then
			
			--Sequenzdetektion
			if detect_sequence(current_state) = '1' and sequence_detected = '0' then
				sequence_detected <= '1';
				detected_flag <= '1';
				timer_active <= '1';
				timer_counter <= 0;
				serial_index <= 0;
				serial_seq <= "110010001010";
			else
				detected_flag <= '0';
			end if;

			--Timer Steuerung
			if timer_active = '1' then
				if timer_counter < pause_duration then
					timer_counter <= timer_counter +1;
				else
					timer_active <= '0';
					sequence_detected <= '0';
				end if;
			end if;
			
			--Serielle Ausgabe Process
			if timer_active = '1' then
				if serial_index < 12 then
					serial_out <= serial_seq(serial_index);
					serial_index <= serial_index +1;
				else
					serial_out <= '0';
				end if;
			end if;
		end if;
	end process;
	
	detected <= detected_flag;
	
	end Behavioral;
	
