library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;

entity Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic;
	  serial_out : out std_logic
	);
end Sequence_Detector;

architecture Behavioral of Sequence_Detector is
	
-- Definition der Zustände der Zustandsmaschine
	type state_type is (S0,S1,S2,S3,S4,SEND);
	signal current_state, next_state : state_type;
		
    	signal timer_active : std_logic := '0';
    	signal timer_counter : integer := 0;

	signal serial_seq : std_logic_vector(3 downto 0);
	signal serial_index : integer := 0;

    	constant pause_duration : integer := 200;

--Funktion für die Zustandsmaschine
function state_transition(bcd_in : std_logic_vector(3 downto 0); current_state : state_type) return state_type is
begin

case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when others =>
      	return S0;
      
end case;
end function;

--Function für die Sequencedetektion
function detect_sequence(current_state : state_type) return std_logic is
begin
  if current_state = S4 then
    return '1';    --Sequence erkannt
  else
    return '0';
  end if;
end function;

--Funktion für die Timersteuerung
procedure timer_process(signal_clk : std_logic; signal reset : in std_logic; signal timer_active : inout std_logic; signal timer_counter : inout integer) is
begin
  if reset = '1' then
		timer_active <= '0';
    timer_counter <= 0;
  elsif rising_edge(clk) then
    if timer_active = '1' then
      if timer_counter < pause_duration then
        timer_counter <= timer_counter +1;
      else
        timer_active <= '0';    --Timer beendet
        timer_counter <= 0;
      end if;
    end if;
  end if;
end procedure;
				
--Funktion fue die serielle Ausgabe
procedure serial_output_process(signal clk : in std_logic; signal serial_seq : std_logic_vector(3 downto 0); signal serial_index : inout integer; signal serial_out : out std_logic) is

begin
	if rising_edge(clk) then
		if serial_index < 4 then
			serial_out <= serial_seq(serial_index);
			serial_index <= serial_index +1;
		else
			serial_out <= '0';	--Ende der Ausgabe
		end if;
	end if;
end procedure;

-- FSM Process

process(clk, reset)
begin
	if reset = '1' then
		curren_state <= '0';
	elsif rising_edge(clk) then
		current_state <= state_transition(seq_in, current_state);
	end if;
end process;

--Sequenzdetektion und Timer Process
process(clk, reset)
begin
	if reset = '1' then
		detected <= '0';
		timer_active <= '0';
	elsif rising_edge(clk) then
		detected <= detect_sequence(current_state);
		if detected = '1' then
			timer_active <= '1';
		end if;
	end if;
end process;

--Timer Process aufrufen
process(clk, reset)
begin
	timer_process(clk, reset, timer_active, timer_counter);
end process;

--Serielle Ausgabe Process
process(clk)
begin
	if timer_active = '1' then
		serial_output_process(clk, serial_seq, serial_index, serial_out);
	end if;
end process;

end Behavioral;
