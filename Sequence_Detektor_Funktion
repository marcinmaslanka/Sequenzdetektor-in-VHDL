--Sequenzdetektion und Timer Process
	process(clk, reset)
	begin
		if reset = '1' then
			detected <= '0';
			internal_timer_active <= '0';
		elsif rising_edge(clk) then
			detected <= detect_sequence(current_state);
			if detected = '1' then
				timer_active <= '1';
			end if;
		end if;
	end process;
	timer_active <= internal_timer_active;

	--Timer Process aufrufen
	process(clk, reset)
	begin
		timer_process(clk, reset, timer_active, timer_counter);
	end process;

	--Serielle Ausgabe Process
	process(clk)
	begin
		if timer_active = '1' then
			serial_output_process(clk, serial_seq, serial_index, serial_out);
		end if;
	end process;
