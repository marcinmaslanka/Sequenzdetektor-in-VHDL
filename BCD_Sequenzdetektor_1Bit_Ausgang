library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity BCD_Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic;
	serial_out : out std_logic			--Serieler Ausgang
	);
end BCD_Sequence_Detector;

architecture Behavioral of BCD_Sequence_Detector is
	
    -- Definition der Zustände der Zustandsmaschine
		type state_type is (S0,S1,S2,S3,S4,OUTPUT);
		signal current_state, next_state : state_type;
		
		signal shift_reg : std_logic_vector(15 downto 0);						--4-Bit Zaehler
		signal bit_counter : integer range 0 to 15 := 0;						--Serieller Ausgang

begin
  
  --Zustandsübergangsprocess (synchron mit dem Takt)
  process(clk, reset)
  begin
    if reset = '1' then
      current_state <= S0;
		
    elsif rising_edge(clk) then
    	current_state <= next_state;
		
  	end if;
  end process;
  
  --Nächster Zusatnd und Ausgabelogik (kombinatorisch)
  process(current_state, bcd_in, bit_counter)
  begin
  
	--Standardwerte setzen  
  	next_state <= current_state;
   detected <= '0';
	serial_out <= '0';
  
    case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when S4 =>
      	detected <= '1';										--Sequenz 3210 erkannt
			shift_reg <= "0011001000010000";					--BCD Sequenz in das Schieberegister laden
 			bit_counter <= 0;
			next_state <= OUTPUT;								--Zuruck zum Start
			
		when OUTPUT =>
			serial_out <= shift_reg(15);
			shift_reg <= shift_reg(14 downto 0) & '0';
			if bit_counter < 15 then
				bit_counter <= bit_counter + 1;
				next_state <= OUTPUT;
			else
				next_state <= S0;
			end if;
			
      when others =>
      	next_state <= S0;							--Fehlerbehandlung: Zurück zum Start
      
		end case;
	end process;

end Behavioral;
