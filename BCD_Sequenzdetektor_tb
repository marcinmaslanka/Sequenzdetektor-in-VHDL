-- arithmetic functions with Signed or Unsigned values
--USE ieee.numeric_std.ALL;
 
ENTITY Sequenzdetektor_BCD_tb IS
END Sequenzdetektor_BCD_tb;
 
ARCHITECTURE behavior OF Sequenzdetektor_BCD_tb IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT BCD_Sequence_Detector
    PORT(
         clk : IN  std_logic;
         reset : IN  std_logic;
         bcd_in : IN  std_logic_vector(3 downto 0);
         detected : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal clk : std_logic := '0';
   signal reset : std_logic := '0';
   signal bcd_in : std_logic_vector(3 downto 0) := (others => '0');

 	--Outputs
   signal detected : std_logic;

   -- Clock period definitions
   constant clk_period : time := 10 ns;
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: BCD_Sequence_Detector PORT MAP (
          clk => clk,
          reset => reset,
          bcd_in => bcd_in,
          detected => detected
        );

   -- Clock process definitions
   clk_process :process
   begin
		clk <= '0';
		wait for 10ns;
		clk <= '1';
		wait for 10ns; 
   end process;
 

   -- Stimulus process
   stim_proc: process
   begin		
      -- hold reset state for 100 ns.
      
		reset <= '1';
		wait for 20ns;
		reset <= '0';
		wait for 20ns;

      -- insert stimulus here 
		
			--Testfall 1: Sequenz 3210
        bcd_in <= "0011";		--3
        wait for 20ns;
        bcd_in <= "0010";		--2
        wait for 20ns;
        bcd_in <= "0001";		--1
        wait for 20ns;
        bcd_in <= "0000";		--0
        wait for 20ns;
		  
		--Testfall 2: Falsche Sequenz 3211
        bcd_in <= "0011";		--3
        wait for 20ns;
        bcd_in <= "0010";		--2
        wait for 20ns;
        bcd_in <= "0001";		--1
        wait for 20ns;
        bcd_in <= "0001";		--1 falsch
        wait for 20ns;
		  
		--Testfall 3: Sequenz 3310
        bcd_in <= "0011";		--3
        wait for 20ns;
        bcd_in <= "0011";		--3 falsch
        wait for 20ns;
        bcd_in <= "0001";		--1
        wait for 20ns;
        bcd_in <= "0000";		--0
        wait for 20ns;
		  
		--Testfall 5: Sequenz 3210
        bcd_in <= "0011";		--3
        wait for 20ns;
        bcd_in <= "0010";		--2
        wait for 20ns;
        bcd_in <= "0001";		--1
        wait for 20ns;
        bcd_in <= "0000";		--0
        wait for 20ns;

      wait;
   end process;

END;
