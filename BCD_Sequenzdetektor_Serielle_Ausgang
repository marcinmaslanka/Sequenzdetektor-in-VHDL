library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.std_logic_arith.all;
use IEEE.std_logic_unsigned.all;
use IEEE.numeric_std.all;

entity BCD_Sequence_Detector is
Port (
  	clk : in std_logic;
  	reset : in std_logic;
  	bcd_in : in std_logic_vector(3 downto 0);
  	detected : out std_logic;
	serial_out : out std_logic			--Serieler Ausgang
	);
end BCD_Sequence_Detector;

architecture Behavioral of BCD_Sequence_Detector is
	
    -- Definition der Zustände der Zustandsmaschine
		type state_type is (S0,S1,S2,S3,S4,SEND);
		signal current_state, next_state : state_type;
		
		signal bit_counter : unsigned(2 downto 0) := (others => '0');							--Serieller Ausgang
		signal serial_data : std_logic_vector(3 downto 0) := "0000";						--4-Bit Zaehler

		--constant BCD_SEQUENCE : std_logic_vector(3 downto 0) := "0101";		--beispiel
begin
  
  --Zustandsübergangsprocess (synchron mit dem Takt)
  process(clk, reset)
  begin
    if reset = '1' then
      current_state <= S0;
		bit_counter <= "000";
    elsif rising_edge(clk) then
    	current_state <= next_state;
		
			if current_state = SEND then
				if bit_counter /= "100" then
					bit_counter <= bit_counter + 1;
				else
					bit_counter <= "000";
				end if;
			end if;
			
  	end if;
  end process;
  
  --Nächster Zusatnd und Ausgabelogik (kombinatorisch)
  process(current_state, bcd_in)
  begin
  
	--Standardwerte setzen  
  	next_state <= current_state;
   detected <= '0';
	serial_out <= '0';
  
    case current_state is
      when S0 =>
      	if bcd_in = "0011" then
			 next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if bcd_in = "0010" then
			 next_state <= S2;
      	else
          next_state <= S0;
      end if;
      
      when S2 =>
      	if bcd_in = "0001" then
			 next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if bcd_in = "0000" then
			 next_state <= S4;
      	else
          next_state <= S0;
      end if;
      
      when S4 =>
      	detected <= '1';									--Sequenz 3210 erkannt
 			serial_data <= "1011";
			next_state <= SEND;								--Zuruck zum Start
			
		when SEND =>
			serial_out <= serial_data(to_integer(bit_counter));
			
			if bit_counter = "011" then
				next_state <= S0;
			else
				next_state <= SEND;
			end if;
			
      when others =>
      	next_state <= S0;							--Fehlerbehandlung: Zurück zum Start
      
		end case;
	end process;

end Behavioral;
