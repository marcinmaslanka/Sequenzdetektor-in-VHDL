LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
 
-- Uncomment the following library declaration if using
-- arithmetic functions with Signed or Unsigned values
--USE ieee.numeric_std.ALL;
 
ENTITY BCD_Sequenzdetektor_Serielle_Ausgang_tb IS
END BCD_Sequenzdetektor_Serielle_Ausgang_tb;
 
ARCHITECTURE behavior OF BCD_Sequenzdetektor_Serielle_Ausgang_tb IS 
 
    -- Component Declaration for the Unit Under Test (UUT)
 
    COMPONENT BCD_Sequence_Detector
    PORT(
         clk : IN  std_logic;
         reset : IN  std_logic;
         bcd_in : IN  std_logic_vector(3 downto 0);
         start_serial : IN  std_logic;
         detected : OUT  std_logic;
         serial_out : OUT  std_logic
        );
    END COMPONENT;
    

   --Inputs
   signal clk : std_logic := '0';
   signal reset : std_logic := '0';
   signal bcd_in : std_logic_vector(3 downto 0) := (others => '0');
   signal start_serial : std_logic := '0';

 	--Outputs
   signal detected : std_logic;
   signal serial_out : std_logic;

   -- Clock period definitions
   constant clk_period : time := 10 ns;
 
BEGIN
 
	-- Instantiate the Unit Under Test (UUT)
   uut: BCD_Sequence_Detector PORT MAP (
          clk => clk,
          reset => reset,
          bcd_in => bcd_in,
          start_serial => start_serial,
          detected => detected,
          serial_out => serial_out
        );

   -- Clock process definitions
   clk_process :process
   begin
		clk <= '0';
		wait for clk_period/2;
		clk <= '1';
		wait for clk_period/2;
   end process;
 

   -- Stimulus process
   stim_proc: process
   begin		
      -- hold reset state for 100 ns.


      -- insert stimulus here 
		
		reset <= '1';
		wait for clk_period*2;
		reset <= '0';
		
		--Testfall 1
		bcd_in <= "0011";
		start_serial <= '1';
		wait for clk_period;
		start_serial <= '0';
		wait for clk_period*5;
		
		--Testfall 2
		bcd_in <= "0010";
		start_serial <= '1';
		wait for clk_period;
		start_serial <= '0';
		wait for clk_period*5;
		
		--Testfall 3
		bcd_in <= "0001";
		start_serial <= '1';
		wait for clk_period;
		start_serial <= '0';
		wait for clk_period*5;
		
		--Testfall 4
		bcd_in <= "0000";
		start_serial <= '1';
		wait for clk_period;
		start_serial <= '0';
		wait for clk_period*5;

      wait;
   end process;

END;
