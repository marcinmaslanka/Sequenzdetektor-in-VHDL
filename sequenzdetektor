library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity Sequence_Detector is
Port (
  	clk : in STD_LOGIC;
  	reset : in STD_LOGIC;
  	seq_in : in STD_LOGIC;
  	detected : out STD_LOGIC
	);
end Sequence_Detector;

architecture Behavioral of Sequence_Detector is
	
    -- Definition der Zustände der Zustandsmaschine
    type state_type is (S0,S1,S2,S3,S4);
	signal current_state, next_state : state_type;

begin
  
  --Zustandsübergangsprocess (synchron mit dem Takt)
  process(clk, reset)
  begin
    if reset = '1' then
      current_state <= S0;
    elsif rising_edge(clk) then
    	current_state <= next_state;
  	end if;
  end process;
  
  --Nächster Zusatnd und Ausgabelogik (kombinatorisch)
  process(current_state, seq_in)
  begin
  
	--Standardwerte setzen  
  	next_state <= current_state;
    detected <= '0';
  
    case current_state is
      when S0 =>
      	if seq_in = '1' then
          next_state <= S1;
      	else
          next_state <= S0;
      	end if;
      
      when S1 =>
      	if seq_in = '0' then
          next_state <= S2;
      	else
          next_state <= S1;
      end if;
      
      when S2 =>
      	if seq_in = '1' then
          next_state <= S3;
      	else
          next_state <= S0;
      end if;
      
      when S3 =>
      	if seq_in = '1' then
          next_state <= S4;
      	else
          next_state <= S1;
      end if;
      
      when S4 =>
      	detected <= '1';	--Sequenz "1011" erkannt
      	if seq_in = '1' then
          next_state <= S1;
      	else
          next_state <= S0;
      end if;
      
      when others =>
      	next_state <= S0;	--Fehlerbehandlung: Zurück zum Start
      
		end case;
	end process;

end Behavioral;
